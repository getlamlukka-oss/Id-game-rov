{
  "expo": {
    "name": "ROV ID Manager",
    "slug": "rov-id-manager",
    "scheme": "rovidmanager",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": {
